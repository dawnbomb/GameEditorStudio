<UserControl x:Class="GameEditorStudio.TextEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GameEditorStudio"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="900">
    <DockPanel Name="BackPanel">
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,3,0,2" Height="30">
            <Button Name="LineIDToggle" Content="L-ID" Width="70" Margin="178,0,0,0" Click="ToggleLineID" ToolTip="Toggles Line ID Numbers On/Off."/>
            <Button Click="ToggleRightSideBar" Name="RightBarToggle" Content="Sidebar" Margin="0,0,0,0"  ToolTip="Toggles the right side bar." DockPanel.Dock="Right" Foreground="#FFA4A4A4"/>

            <TextBox TextChanged="SearchBarTextChanged" KeyDown="SearchBarKeyDown" Name="SearchBar" Margin="16,2,5,2" TextWrapping="NoWrap" AcceptsReturn="False" Text="Search" MinWidth="300"/>
            <Label Name="SearchResultLabel" Content="0 / 0" />
            <Button Click="SearchPreviousClick" Content="Prev" Width="NaN"/>
            <Button Click="SearchNextClick" Content="Next" Width="NaN"/>

        </DockPanel>
        <Grid x:Name="MainGrid" DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <local:FileManager x:Name="TextFileManager"  Grid.Column="0"  />

            <GridSplitter Style="{DynamicResource SplitterVertical}" Grid.Column="1" Width="12" Background="Transparent"  />

            <ContentControl Grid.Column="2">
                <ScrollViewer  Background="Transparent" BorderThickness="0">
                    <DockPanel Background="Transparent" >
                        <TextBox Name="TheLineBox" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" DockPanel.Dock="Left" IsReadOnly="True" MinWidth="30" BorderThickness="0,0,2,0"/>
                        <TextBox Name="TheTextBox" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden" DockPanel.Dock="Left" TextChanged="TextBoxTextChanged" KeyDown="TextBoxKeyDown"  AcceptsReturn="True" BorderThickness="0" IsInactiveSelectionHighlightEnabled="True"/>
                    </DockPanel>
                </ScrollViewer>
            </ContentControl>

            <DockPanel x:Name="RightSideBar" Grid.Column="3" Visibility="Collapsed" MaxWidth="400">
                <local:DocumentsUserControl x:Name="DocumentsControl"/>
            </DockPanel>

        </Grid>
    </DockPanel>
</UserControl>
