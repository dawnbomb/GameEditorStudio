<UserControl x:Class="GameEditorStudio.WorkshopMaker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GameEditorStudio"
             mc:Ignorable="d" >
    <Grid x:Name="WorkshopTab" >
        <Border Height="38" VerticalAlignment="Top">
            <DockPanel >
                <Border Style="{DynamicResource ContentBorder}" DockPanel.Dock="Top">
                    <DockPanel Style="{DynamicResource ContentBar}" >
                        <Label Content="Workshop Manager" FontWeight="Bold" />
                        <Button x:Name="ButtonCancel" Content="Exit without saving" HorizontalAlignment="Right" Margin="0,1,5,1" VerticalAlignment="Top"  Width="230" Click="ButtonCancel_Click" Height="30"/>
                    </DockPanel>
                </Border>

            </DockPanel>
        </Border>

        <ContentControl Margin="26,63,0,0" Width="600" HorizontalAlignment="Left" Height="325" VerticalAlignment="Top">
            <DockPanel  >
                <Border Style="{DynamicResource ContentBorder}" DockPanel.Dock="Top">
                    <DockPanel Style="{DynamicResource ContentBar}" >
                        <Label Content="Workshop Info" FontWeight="Bold" />
                    </DockPanel>
                </Border>
                <DockPanel DockPanel.Dock="Top" Margin="10,0,10,0" Height="70" >
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                        <Label Content="Workshop Name (name of your game)" DockPanel.Dock="Left" Margin="-3,0,0,0"  />
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" >
                        <Border CornerRadius="8" BorderBrush="Black"  BorderThickness="1.5" Padding="2" Background="#FF18191B">
                            <TextBox x:Name="TextBoxGameName" Margin="2,0,2,0" Padding="4"  BorderThickness="0"  DockPanel.Dock="Left" TextChanged="WorkshopNameTextboxTextChanged" />
                        </Border>
                    </DockPanel>
                </DockPanel>

                <DockPanel DockPanel.Dock="Top" Margin="10,10,10,0" Height="72"   >
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                        <Label Content="Suggested Input Folder:" DockPanel.Dock="Left" Margin="-3,0,0,0"  />
                        <Button x:Name="ButtonSetWorkshopInputFolder" Content="Browse..." Height="30"  Width="100" Click="ButtonSetWorkshopInputFolder_Click" Padding="0,1,1,0" DockPanel.Dock="Right" />


                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Border CornerRadius="8" BorderBrush="Black"  BorderThickness="1.5" Padding="2" Background="#FF18191B">
                            <TextBox x:Name="WorkshopTextboxExampleInputFolder" Margin="2,0,2,0" Padding="4"  BorderThickness="0"  DockPanel.Dock="Left"  />
                        </Border>


                    </DockPanel>
                </DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,10,0,0"  VerticalAlignment="Top" HorizontalAlignment="Left">
                    <CheckBox Name="WorkshopCheckboxSameFolderName"/>
                    <Label Content="Instead of having a suggested input folder, &#xA;REQUIRE users to select an input folder with this name."/>
                </DockPanel>
                <Button x:Name="ButtonCreateNewWorkshop" Content="Create New Workshop"  Margin="0,10,0,0"  Height="33" Width="336" Click="ButtonCreateNewWorkshop_Click" />

            </DockPanel>
        </ContentControl>







        <Label Content="=== ABOUT THE SUGGESTED INPUT FOLDER ===&#xA;Editors mod files inside folder X, selected by the user. &#xA;This is your way to SUGGEST a specific folder name.&#xA;(This is the folder where the game files should be)&#xA;(Users can ignore it and use another name / select another folder)&#xA;(GES saves modded game files to a diffrent output &#xA;folder, so the input can be a backup of unmodded game files)&#xD;&#xA;(Instead of a set folder name, you can also type instructions,&#xD;&#xA;such as &quot;Select your unpacked rom folder&quot;)&#xA;&#xA;Suggesting an input folder name is NOT required. &#xA;(Extra useful for GBA / SNES / etc romhacks)&#xA;(You can also just leave it blank)&#xA;&#xA;You can also REQUIRE users to select a specific folder name.&#xA;(Please only use this under special circumstances)&#xA;&#xA;=== Notes on File Repacking ===&#xA;Game Editor Studio has an eventing system where you can&#xA;setup automatic file repacking and file moving.&#xA;Just something to keep in mind. &#xA;" HorizontalAlignment="Left" Margin="652,262,0,0" VerticalAlignment="Top" />
        <Label Content="Note: &#xA;The workshop name becomes a folder name, so don't use&#xA;symbols that windows will reject or saving will crash.&#xA;&#xA;Some banned Symbols:&#xA;/ \ : * &quot; &lt; &gt; ? |&#xA;&#xA;Some allowed Symbols:&#xA;= - ! @ # $ % ^ &amp; ( ) ` ~ ' [] {}" HorizontalAlignment="Left" Margin="42,411,0,0" VerticalAlignment="Top" Background="#FF190A09" Foreground="#FFFF2121"/>
        <Label Content="=== ABOUT WORKSHOPS ===&#xA;A workshop is simply all the editors for a game. &#xA;So in general, the name should just be the game's name.&#xA;That said, for some games, maybe add extra info like...&#xA;&quot;World End Reboot (EU)&quot;&#xA;&quot;Seiken Ocean - v2 update&quot;&#xA;&quot;Blast Force (PS2)&quot; &lt;- Good way to handle remakes" HorizontalAlignment="Left" Margin="652,63,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.503,0.052" />
        <!--<Button x:Name="ButtonVerifyWorkshop" Content="Verify Workshop for this version of GES" Click="ButtonCreateNewWorkshop_Click" Margin="113,664,797,56" />-->


    </Grid>
</UserControl>
