<UserControl x:Class="GameEditorStudio.WToolsManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GameEditorStudio"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Label Content="CLICK THIS -> " HorizontalAlignment="Left" Margin="10,2,0,0" VerticalAlignment="Top"/>
        <Button Click="HelpButtonClick"  Content="Help!" HorizontalAlignment="Left" Margin="167,7,0,0" VerticalAlignment="Top"/>
        <Button Click="SaveExitButtonClick"  Content="Save and Exit" HorizontalAlignment="Left" Margin="646,7,0,0" VerticalAlignment="Top"/>
        <!--<Button Click="ExitButtonClick"  Content="Close without saving" HorizontalAlignment="Left" Margin="422,7,0,0" VerticalAlignment="Top"/>-->

        <DockPanel HorizontalAlignment="Left" Width="167" Margin="10,41,0,10">
            <ContentControl DockPanel.Dock="Top">
                <DockPanel>
                    <Border Style="{DynamicResource ContentBorder}"  DockPanel.Dock="Top">
                        <DockPanel LastChildFill="False" Style="{DynamicResource ContentBar}" DockPanel.Dock="Top" >
                            <Label Content="Tools" FontWeight="Bold" />
                            <Button Click="AddNewSpecialTool" Content="New" Margin="3,3,10,3" DockPanel.Dock="Right"/>
                        </DockPanel>
                    </Border>
                    <TreeView x:Name="TreeViewTools" SelectedItemChanged="ToolTreeSelectionChanged" MinHeight="100"/>
                </DockPanel>
            </ContentControl>
        </DockPanel>

        <ContentControl DockPanel.Dock="Top" Margin="198,42,10,10">
            <DockPanel>
                <Border Style="{DynamicResource ContentBorder}"  DockPanel.Dock="Top">
                    <DockPanel LastChildFill="False" Style="{DynamicResource ContentBar}" DockPanel.Dock="Top" >
                        <Label Content="Tool Info" FontWeight="Bold" />
                    </DockPanel>
                </Border>
                <Grid Name="ToolInfoPanel" Background="#FF21211F">
                    <Label Content="Display Name:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                    <TextBox TextChanged="ToolDisplayNameTextChanged" Name="ToolDisplayNameTextbox" HorizontalAlignment="Left" Margin="155,13,0,0" TextWrapping="NoWrap" VerticalAlignment="Top" Width="190"/>
                    <Label Content="Name of tool .exe:" HorizontalAlignment="Left" Margin="10,52,0,0" VerticalAlignment="Top"/>
                    <TextBox TextChanged="ToolExeTextChanged" Name="ToolExeTextbox" Margin="199,55,10,0" TextWrapping="NoWrap" VerticalAlignment="Top"/>

                    <Label Content="Description (Doubles as Tooltip)" HorizontalAlignment="Left" Margin="10,91,0,0" VerticalAlignment="Top"/>
                    <TextBox TextChanged="DescriptionTextChanged" Name="DescriptionTextbox" Margin="10,130,10,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="73"/>

                    <Label Content="Download Link" HorizontalAlignment="Left" Margin="12,208,0,0" VerticalAlignment="Top"/>
                    <TextBox TextChanged="LinkTextChanged" Name="DownloadLinkTextbox" Margin="11,242,11,0" TextWrapping="NoWrap" VerticalAlignment="Top"/>

                    <Label Content="Notes (Never shown anywhere else, basically dev notes)" HorizontalAlignment="Left" Margin="12,275,0,0" VerticalAlignment="Top"/>
                    <TextBox TextChanged="NotesTextChanged" Name="NotesTextbox" Margin="10,309,10,0" TextWrapping="Wrap" VerticalAlignment="Top"/>
                    
                    <Button Click="DeleteClick" Name="DeleteButton" Content="Delete" HorizontalAlignment="Left" Margin="428,15,0,0" VerticalAlignment="Top"/>




                </Grid>
            </DockPanel>
        </ContentControl>

    </Grid>
</UserControl>
