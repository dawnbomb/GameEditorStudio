<UserControl x:Class="GameEditorStudio.MathBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GameEditorStudio"
             mc:Ignorable="d" >
    <Border Name="MathboxBorder" BorderBrush="#FF000210" CornerRadius="3" BorderThickness="2"  Background="#FF142146">
        <DockPanel Name="GridItemDockPanel" Background="{x:Null}" >
            <Grid Name="MathboxLeftGrid" Background="Transparent">
                <Label Name="MathboxLabel" Content="Math" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border Name="MathboxTooltipLine" BorderBrush="#A0A0A0" Margin="4,0,5,4" BorderThickness="0,0,0,2" />
            </Grid>
            <DockPanel Background="Transparent">  <!--Background="#FF0C0D35"-->
                <TextBox Name="MathResultBox" Margin="3" Text="Box" IsEnabled="False"  /> <!--Background="#FF3C3F46"-->
            </DockPanel>
        </DockPanel>        
    </Border>
</UserControl>
