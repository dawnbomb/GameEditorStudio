<UserControl x:Class="GameEditorStudio.GameLibrary"
        
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameEditorStudio"
        mc:Ignorable="d"
        
        
        xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero2">
    <UserControl.Resources>
        <local:LocationToColorConverter x:Key="LocationToColorConverter" />
    </UserControl.Resources>
    <Grid Name="LibraryGrid" >
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="835*"/>
            <RowDefinition Height="14"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="452*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="650*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="14"/>
        </Grid.ColumnDefinitions>
        <!--Below should equal the width of it's column-->
        <!--<GridSplitter  Grid.Column="2" Grid.Row="3" Grid.RowSpan="2" Style="{DynamicResource SplitterVertical}" Width="4"   />-->

        <DockPanel Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="7" Style="{DynamicResource AppOther}" >
            <DockPanel Margin="15,0,15,0" Grid.Column="1" Grid.ColumnSpan="5"  Grid.Row="0" Grid.RowSpan="1" Background="Transparent" DockPanel.Dock="Top">
                <local:TopMenu x:Name="MainMenu" DockPanel.Dock="Top" />

            </DockPanel>

            <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7"   Grid.RowSpan="1" LastChildFill="False" Background="Transparent" DockPanel.Dock="Bottom">
                <local:TIPS x:Name="Ma1inMenu" DockPanel.Dock="Top" Margin="20,-1,20,4" />
                <Border DockPanel.Dock="Bottom" BorderBrush="#575757" BorderThickness="0,2,0,0"/>
                <Border DockPanel.Dock="Bottom" BorderThickness="0,2,0,0"/>
            </DockPanel>
        </DockPanel>



        <DockPanel Grid.Row="3" Grid.Column="1" Background="{x:Null}" Grid.RowSpan="1">
                       

            <!--//Style="{DynamicResource PixelBorder}"-->
            <ContentControl Name="ProjectsContent" DockPanel.Dock="Bottom" Height="150" Margin="0,14,0,0" Background="Green"  >
                <DockPanel Background="Green">
                    <Border Style="{DynamicResource ContentBorder}" DockPanel.Dock="Top">
                        <DockPanel LastChildFill="False" Style="{DynamicResource ContentBar}" >
                            <Label Content="Your mods for this game" FontWeight="Bold" />
                            <!--<Button DockPanel.Dock="Right" Content="New"  Height="30" MinWidth="50" Margin="0,3,10,2" Click="CreateNewProject" Width="60" ToolTip="Create a new Mod / Project."  />-->
                        </DockPanel>
                    </Border>
                    <DataGrid  Background="Green" HeadersVisibility="None" x:Name="ProjectsSelector" AutoGenerateColumns="False" DockPanel.Dock="Right" VerticalAlignment="Stretch" IsReadOnly="True" SelectionChanged="ProjectSelected" FontSize="15"  >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Projects" Binding="{Binding ProjectName}" Width="*"  />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="{x:Type DataGridRow}" >
                                <!--<EventSetter Event="MouseDoubleClick" Handler="Row_DoubleClick"  />-->
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <!--<MenuItem Header="New Project" Click="CreateNewProject" />-->
                                <MenuItem Header="Open Project Folder" Click="OpenProjectFolder" />
                                <MenuItem Header="Open Input Folder" Click="OpenInput" />
                                <MenuItem Header="Open Output Folder" Click="OpenOutput" />
                                <MenuItem Header="Delete Project" Click="DeleteProject" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                </DockPanel>
            </ContentControl>

            <ContentControl Name="RecentWorkshopsContent" DockPanel.Dock="Top" Margin="0,0,0,10">
                <DockPanel>
                    <Border Style="{DynamicResource ContentBorder}"  DockPanel.Dock="Top">
                        <DockPanel LastChildFill="False" Style="{DynamicResource ContentBar}" DockPanel.Dock="Top" >
                            <Label Content="Recent Workshops" FontWeight="Bold" />


                            <Button DockPanel.Dock="Right"  Content="Launch Workshop"  Click="LaunchWorkshopPreviewMode"  FontSize="20" Margin="3,3,10,3"  ToolTip="Launch a workshop and check out what editors it has! &#xD; &#xD;A 'workshop' is basically a collection of editors for a specific game. &#xD;Well, it also holds documents, game modding tools, &#xD;lets you setup automatic file repacking, and much more...  &#xD; &#xD;Still, 'A workshop is the editors for a game' is a good starting point of understanding." ToolTipService.InitialShowDelay="5" />

                        </DockPanel>
                    </Border>

                    <TreeView  x:Name="LibraryTreeOfRecentWorkshops"  SelectedItemChanged="RecentWorkshopsTree_SelectedItemChanged" DockPanel.Dock="Top" MinHeight="25" /> 

                </DockPanel>
            </ContentControl>

            <ContentControl DockPanel.Dock="Top" >
                <DockPanel>                    
                    <Border Style="{DynamicResource ContentBorder}"  DockPanel.Dock="Top">
                        <DockPanel LastChildFill="False" Style="{DynamicResource ContentBar}" DockPanel.Dock="Top" >
                            <Label Content="Workshops" FontWeight="Bold" />


                            <Button Click="LaunchWorkshopPreviewMode" DockPanel.Dock="Right" x:Name="ButtonLaunchPreview"   Content="Launch Workshop"    FontSize="20" Margin="3,3,10,3"  ToolTip="Launch a workshop and check out what editors it has! &#xD; &#xD;A 'workshop' is basically a collection of editors for a specific game. &#xD;Well, it also holds documents, game modding tools, &#xD;lets you setup automatic file repacking, and much more...  &#xD; &#xD;Still, 'A workshop is the editors for a game' is a good starting point of understanding." ToolTipService.InitialShowDelay="5" />
                            <Button Click="ButtonEditWorkshop2" DockPanel.Dock="Right" x:Name="ButtonEditWorkshop" Content="Edit"  Width="60"  FontSize="20" Margin="3"   ToolTip="Edit the selected workshop's info." />
                            <Button Click="ButtonCreateWorkshop2" DockPanel.Dock="Right" x:Name="ButtonCreateWorkshop" Content="New" Width="55"  FontSize="20" Margin="3,3,3,3" ToolTip="Create a new workshop.  &#xD;A Workshop (name inspired by the steam workshop) is where a game's editors are located.  &#xD;(Enemy editor, Item editor, Skill editor, etc)" />
                            
                        </DockPanel>
                    </Border>

                    <TreeView  x:Name="LibraryTreeOfWorkshops"  SelectedItemChanged="LibraryTreeOfWorkshops_SelectedItemChanged" DockPanel.Dock="Top" />
                    
                </DockPanel>
            </ContentControl>


        </DockPanel>












        <DockPanel Grid.Column="3" Grid.Row="3" Grid.ColumnSpan="1"  Grid.RowSpan="1" Background="{x:Null}"  >

            
            <ContentControl Name="ProjectResourceControl" DockPanel.Dock="Bottom" Height="300" Margin="0,14,0,0" BorderThickness="2,0,2,2" BorderBrush="#575757">
                <DockPanel DockPanel.Dock="Bottom" Background="{x:Null}" >

                    <Border Style="{DynamicResource ContentBorder}" DockPanel.Dock="Top">
                        <DockPanel LastChildFill="False" Style="{DynamicResource ContentBar}" >
                            <Label Content="Project Resources" FontWeight="Bold" />
                            <Label Name="LabelForMissingProjectResources" Content="Some last known locations are wrong?" FontWeight="Bold" Background="#FF440A0A" Foreground="#FFFF1800" Visibility="Collapsed" Height="26" Padding="5,0,5,2" Margin="10,0,0,0" />
                        </DockPanel>
                    </Border>
                    
                    <!--Note: Only local files/folders appear here, never child ones, because the user doesn't need to actually set them (thats the point of child items).-->
                    <DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" >
                            <DockPanel>
                                <DockPanel Name="ProjectEventResourcesPanel"  LastChildFill="False" DockPanel.Dock="Top" Background="{x:Null}" >

                                </DockPanel>
                            </DockPanel>

                        </ScrollViewer>
                    </DockPanel>
                    
                </DockPanel>
            </ContentControl>
            
            <ContentControl BorderThickness="2,0,2,2" BorderBrush="#575757">
                <Grid>
                    <DockPanel>
                        <Border Style="{DynamicResource ContentBorder}" DockPanel.Dock="Top">
                            <DockPanel LastChildFill="False" Style="{DynamicResource ContentBar}" >
                                <Label Name="DocumentNameLabel" Content="Welcome to Game Editor Studio!" FontWeight="Bold" HorizontalAlignment="Center" DockPanel.Dock="Top" />

                            </DockPanel>
                        </Border>

                        <ScrollViewer Background="Transparent" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="StackPanelForWorkshopDocument"   Margin="10,10,10,10" Focusable="False" Background="{x:Null}" />

                        </ScrollViewer>
                    </DockPanel>
                    
                    <DockPanel Name="LoadingPanel" DockPanel.Dock="Top" Background="#FF1B1B1B" Visibility="Collapsed">
                        <StackPanel Margin="20" DockPanel.Dock="Top">
                            <DockPanel HorizontalAlignment="Center" Background="Transparent">
                                <Label x:Name="LoadingWatch" Margin="0,0,20,0" DockPanel.Dock="Left"/>
                                <Label x:Name="LoadingTimer" Margin="20,0,0,5" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <!--<Label x:Name="LoadingTimer" Margin="0,0,0,5" HorizontalAlignment="Center"/>-->
                            <Label x:Name="LoadingPartText" Content="Loading..." Margin="0,0,0,5" HorizontalAlignment="Center"/>
                            <Label x:Name="LoadingStatusText" Content="Loading..." Margin="0,0,0,5" HorizontalAlignment="Center"/>
                            <ProgressBar x:Name="LoadingProgressBar" Minimum="0" Maximum="100"/>
                        </StackPanel>
                        <StackPanel Name="LoadingFinalPanel" Margin="20" DockPanel.Dock="Top">
                            <Label Content="Finalizing some last things..." Margin="0,0,0,5" HorizontalAlignment="Center"/>
                            <!--<Label x:Name="LoadingPartText" Content="Loading..." Margin="0,0,0,5" HorizontalAlignment="Center"/>
                            <Label x:Name="LoadingStatusText" Content="Loading..." Margin="0,0,0,5" HorizontalAlignment="Center"/>
                            <ProgressBar x:Name="LoadingProgressBar" Height="20" Minimum="0" Maximum="100"/>-->
                        </StackPanel>
                    </DockPanel>
                </Grid>
                
                
            </ContentControl>
            




        </DockPanel>


        <DockPanel Grid.Column="5" Grid.Row="3" Background="{x:Null}" LastChildFill="False" Grid.RowSpan="1">

            <ContentControl DockPanel.Dock="Top" MinHeight="100" BorderThickness="2,0,2,2" BorderBrush="#575757" >
                <DockPanel LastChildFill="True">
                    <Border Style="{DynamicResource ContentBorder}" DockPanel.Dock="Top">
                        <DockPanel Style="{DynamicResource ContentBar}"  ToolTip="You can read the documents of this workshop right from this launcher window! &#xD;   &#xD;Actually pretty useful when your new and first starting out.">
                            <Label Content="Workshop Info" FontWeight="Bold" />
                        </DockPanel>
                    </Border>
                    <DockPanel Style="{DynamicResource DockList}" >
                        <Label Content="Created:" DockPanel.Dock="Top" />
                        <Label Name="WorkshopCreatedLabel" Content="GES V1.0 (June 7 1990)" DockPanel.Dock="Top" />
                        <Label Content="Last used:" DockPanel.Dock="Top" Margin="0,20,0,0" />
                        <Label Name="WorkshopSavedLabel" Content="GES V1.0 (June 7 1990)" DockPanel.Dock="Top" />
                    </DockPanel>
                    
                </DockPanel>
            </ContentControl>

            <ContentControl DockPanel.Dock="Top" MinHeight="200" BorderThickness="2,0,2,2" Margin="0,14,0,0" BorderBrush="#575757" >
                <DockPanel LastChildFill="True">
                    <Border Style="{DynamicResource ContentBorder}" DockPanel.Dock="Top">
                        <DockPanel Style="{DynamicResource ContentBar}"  ToolTip="You can read the documents of this workshop right from this launcher window! &#xD;   &#xD;Actually pretty useful when your new and first starting out.">
                            <Label Content="📄📝 Documents" FontWeight="Bold" />
                            <Label Name="DocumentCountLabel" Content="(-)" FontWeight="Bold" />
                        </DockPanel>
                    </Border>                    
                    <TreeView x:Name="LibraryDocumentsTree" DockPanel.Dock="Left" SelectedItemChanged="DocumentsTreeSelectedItemChanged" />
                </DockPanel>
            </ContentControl>

            
            <ContentControl DockPanel.Dock="Top" MinHeight="200" Margin="0,14,0,0" BorderThickness="2,0,2,2">
                <DockPanel>
                    <Border Style="{DynamicResource ContentBorder}" DockPanel.Dock="Top">
                        <DockPanel LastChildFill="False" Style="{DynamicResource ContentBar}" ToolTip="Lets you see what editors are in this workshop. &#xD;To use them, create a project/mod and launch the workshop." >
                            <Label Content="⚙️ Editors" FontWeight="Bold" />
                            <Label Name="EditorCountLabel" Content="(-)" FontWeight="Bold" />
                        </DockPanel>
                    </Border>
                    
                    <Grid DockPanel.Dock="Top" Background="#FF3C3C3C">
                        <TreeView x:Name="EditorsTree"/>

                    </Grid>
                    


                </DockPanel>
            </ContentControl>
            

            <!--Just make it so users can check the website for update patchnotes, etc. Most programs do this.-->

            <!--<Border DockPanel.Dock="Top" MinHeight="160" Margin="0,16,0,0">
                <DockPanel>
                    <DockPanel LastChildFill="False" Style="{DynamicResource HeaderDock}" DockPanel.Dock="Top" >
                        <Label Content="Updates" FontWeight="Bold" />

                    </DockPanel>
                    <Grid DockPanel.Dock="Top" Background="#FF3C3C3C">
                        <TreeView />

                    </Grid>
                </DockPanel>

            </Border>-->
        </DockPanel>




    </Grid>

</UserControl>
